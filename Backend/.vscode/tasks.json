{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SIMPOS: Jalankan server (port 8080)",
            "type": "shell",
            "command": "C:\\php\\php.exe",
            "args": [
                "spark",
                "serve",
                "--host",
                "127.0.0.1",
                "--port",
                "8080"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "SIMPOS: Daftar route",
            "type": "shell",
            "command": "C:\\php\\php.exe",
            "args": [
                "spark",
                "routes"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
